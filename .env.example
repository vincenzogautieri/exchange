# Copy this file to ".env" and fill in your own values.
# Never commit the real ".env" file to version control.

# Generate a new secret key, e.g. with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change_this_to_a_random_secret_key

DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# MongoDB connection (used via djongo). Defaults match a local,
# unauthenticated MongoDB instance — override if yours is different.
MONGO_DB_NAME=exchange_data
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_USERNAME=
MONGO_PASSWORD=
